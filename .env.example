# App
DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Encrypts the portal password (the organization's portal credentials) at rest.
# Generate your own with: deedflow genkey
FIELD_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Postgres
POSTGRES_DB=deedflow
POSTGRES_USER=deedflow
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Selenium (headless Chrome, used by the worker to drive the Registration
# Department portal)
SELENIUM_REMOTE_URL=http://selenium:4444/wd/hub

# AI structuring: the fine-tuned OpenAI model is tried first; Claude is the
# fallback (set AI_CLAUDE_FALLBACK=1 to enable it)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=ft:gpt-4.1-2025-04-14:personal:adharamcommon04222025:BP3OKKys
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-5
AI_CLAUDE_FALLBACK=0

# OCR (captcha solving)
TESSERACT_CMD=/usr/bin/tesseract

# Email (receipt alerts): Amazon SES, or plain SMTP
# AWS_REGION=ap-south-1
# AWS_SES_SENDER=
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# SITE_URL=https://deedflow.example.com
